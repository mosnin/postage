// PostSyncer Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(USER)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // App relations
  memberships  WorkspaceMember[]
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  apiKeys      ApiKey[]
  activityLogs ActivityLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── WORKSPACES ───────────────────────────────────────────────────────────────

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  plan        Plan     @default(FREE)
  ownerId     String
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Onboarding
  onboardingCompleted Boolean @default(false)
  onboardingStep      String?

  owner           User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members         WorkspaceMember[]
  subscription    Subscription?
  socialAccounts  SocialAccount[]
  posts           Post[]
  labels          Label[]
  campaigns       Campaign[]
  mediaFiles      MediaFile[]
  apiKeys         ApiKey[]
  settings        WorkspaceSettings?
  activityLogs    ActivityLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String?
  role        WorkspaceRole    @default(MEMBER)
  status      MemberStatus     @default(ACTIVE)
  invitedEmail String?
  inviteToken  String?         @unique
  inviteExpiresAt DateTime?
  invitedAt   DateTime?
  joinedAt    DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model WorkspaceSettings {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  approvalRequired   Boolean  @default(false)
  defaultTimezone    String   @default("UTC")
  aiCreditsUsed      Int      @default(0)
  aiCreditsLimit     Int      @default(1000)
  aiCreditsResetAt   DateTime?
  preferences        Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_settings")
}

// ─── SUBSCRIPTIONS ────────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  workspaceId          String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── SOCIAL ACCOUNTS ─────────────────────────────────────────────────────────

model SocialAccount {
  id           String          @id @default(cuid())
  workspaceId  String
  platform     Platform
  platformId   String
  username     String
  displayName  String
  avatarUrl    String?
  status       AccountStatus   @default(ACTIVE)
  accessToken  String          @db.Text
  refreshToken String?         @db.Text
  tokenExpiresAt DateTime?
  scopes       String[]
  metadata     Json            @default("{}")
  connectedAt  DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     PostAccount[]

  @@unique([workspaceId, platform, platformId])
  @@map("social_accounts")
}

// ─── POSTS ────────────────────────────────────────────────────────────────────

model Post {
  id             String      @id @default(cuid())
  workspaceId    String
  authorId       String?
  content        String      @db.Text
  contentVariants Json       @default("{}")  // per-platform content overrides
  status         PostStatus  @default(DRAFT)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  firstComment   String?     @db.Text
  isThread       Boolean     @default(false)
  threadParts    Json        @default("[]")
  isCarousel     Boolean     @default(false)
  carouselSlides Json        @default("[]")
  queuePosition  Int?
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Approval workflow
  approvalStatus   ApprovalStatus? @default(NOT_REQUIRED)
  approvalNote     String?
  approvedById     String?
  approvedAt       DateTime?
  submittedForApprovalAt DateTime?

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accounts     PostAccount[]
  media        PostMedia[]
  labels       PostLabel[]
  campaignPost CampaignPost[]
  publishLogs  PublishLog[]

  @@map("posts")
}

model PostAccount {
  id              String        @id @default(cuid())
  postId          String
  socialAccountId String
  status          PostStatus    @default(SCHEDULED)
  platformPostId  String?
  publishedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  retryCount      Int           @default(0)

  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([postId, socialAccountId])
  @@map("post_accounts")
}

model PublishLog {
  id         String   @id @default(cuid())
  postId     String
  platform   Platform
  status     String
  response   Json?
  attemptAt  DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("publish_logs")
}

// ─── MEDIA ────────────────────────────────────────────────────────────────────

model MediaFile {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  url         String
  thumbnailUrl String?
  mimeType    String
  size        Int       // bytes
  width       Int?
  height      Int?
  duration    Float?    // seconds for video
  folderId    String?
  tags        String[]
  source      String    @default("upload") // upload, google_drive, unsplash
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder    MediaFolder? @relation(fields: [folderId], references: [id])
  postMedia PostMedia[]

  @@map("media_files")
}

model MediaFolder {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  parentId    String?
  createdAt   DateTime @default(now())

  files    MediaFile[]
  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children MediaFolder[] @relation("FolderTree")

  @@unique([workspaceId, name, parentId])
  @@map("media_folders")
}

model PostMedia {
  id          String    @id @default(cuid())
  postId      String
  mediaFileId String
  order       Int       @default(0)
  altText     String?

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])

  @@unique([postId, mediaFileId])
  @@map("post_media")
}

// ─── LABELS & CAMPAIGNS ───────────────────────────────────────────────────────

model Label {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     PostLabel[]

  @@unique([workspaceId, name])
  @@map("labels")
}

model PostLabel {
  postId  String
  labelId String

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([postId, labelId])
  @@map("post_labels")
}

model Campaign {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  goal        String?
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     CampaignPost[]

  @@map("campaigns")
}

model CampaignPost {
  campaignId String
  postId     String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([campaignId, postId])
  @@map("campaign_posts")
}

// ─── ANALYTICS ────────────────────────────────────────────────────────────────

model AnalyticsSnapshot {
  id              String   @id @default(cuid())
  workspaceId     String
  socialAccountId String
  platform        Platform
  date            DateTime @db.Date
  impressions     Int      @default(0)
  engagements     Int      @default(0)
  likes           Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  clicks          Int      @default(0)
  reach           Int      @default(0)
  saves           Int      @default(0)
  followerCount   Int      @default(0)
  followerChange  Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([socialAccountId, date])
  @@map("analytics_snapshots")
}

model PostAnalytics {
  id             String   @id @default(cuid())
  postId         String
  platform       Platform
  platformPostId String?
  impressions    Int      @default(0)
  engagements    Int      @default(0)
  likes          Int      @default(0)
  comments       Int      @default(0)
  shares         Int      @default(0)
  clicks         Int      @default(0)
  reach          Int      @default(0)
  saves          Int      @default(0)
  syncdAt        DateTime @default(now())

  @@unique([postId, platform])
  @@map("post_analytics")
}

// ─── COMMENTS / INBOX ─────────────────────────────────────────────────────────

model Comment {
  id              String        @id @default(cuid())
  workspaceId     String
  socialAccountId String
  platform        Platform
  platformId      String
  platformPostId  String?
  authorName      String
  authorUsername  String?
  authorAvatar    String?
  content         String        @db.Text
  isReply         Boolean       @default(false)
  parentId        String?
  status          CommentStatus @default(UNREAD)
  isHidden        Boolean       @default(false)
  publishedAt     DateTime
  syncedAt        DateTime      @default(now())

  replies   CommentReply[]

  @@unique([platform, platformId])
  @@map("comments")
}

model CommentReply {
  id        String   @id @default(cuid())
  commentId String
  content   String   @db.Text
  sentAt    DateTime @default(now())
  sentById  String?

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("comment_replies")
}

// ─── API KEYS ─────────────────────────────────────────────────────────────────

model ApiKey {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  keyHash     String   @unique
  keyPrefix   String   // first 8 chars for display
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// ─── ACTIVITY LOG ─────────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  SUPER_ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum Plan {
  FREE
  STARTER
  PRO
  PRO_PLUS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
  UNPAID
}

enum Platform {
  TWITTER
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
  PINTEREST
  THREADS
  TELEGRAM
  LINKEDIN
  BLUESKY
  MASTODON
}

enum AccountStatus {
  ACTIVE
  DISCONNECTED
  ERROR
  EXPIRED
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum CommentStatus {
  UNREAD
  READ
  RESOLVED
  REPLIED
}
